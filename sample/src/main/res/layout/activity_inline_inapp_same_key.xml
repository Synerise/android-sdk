<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/include_app_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_content">

            <TextView
                style="@style/TextPrimary.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Component 1 (single)"
                android:layout_marginBottom="4dp" />

            <FrameLayout
                android:id="@+id/container_1"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="#11000000"
                android:layout_marginBottom="16dp" />

            <TextView
                style="@style/TextPrimary.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Component 2 (single)"
                android:layout_marginBottom="4dp" />

            <FrameLayout
                android:id="@+id/container_2"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="#11000000"
                android:layout_marginBottom="16dp" />

            <TextView
                style="@style/TextPrimary.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Component 3 (single)"
                android:layout_marginBottom="4dp" />

            <FrameLayout
                android:id="@+id/container_3"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="#11000000"
                android:layout_marginBottom="16dp" />

            <TextView
                style="@style/TextPrimary.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Component 4 (fourth)"
                android:layout_marginBottom="4dp" />

            <FrameLayout
                android:id="@+id/container_4"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="#11000000"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_send_event"
                style="@style/ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Send event (inline.samekey)" />

            <Button
                android:id="@+id/btn_send_event_overlay"
                style="@style/ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Send event (overlay.test)" />

            <TextView
                style="@style/TextPrimary.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Callback Log:" />

            <TextView
                android:id="@+id/log_text"
                style="@style/TextSecondary.Mini"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
