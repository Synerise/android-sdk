<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/include_app_bar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- STATE 1: HOST — search bar; inline pre-renders here at 0x0 -->
        <LinearLayout
            android:id="@+id/host_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/space_content">

            <TextView
                android:id="@+id/search_bar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#11000000"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Search in Sinsay…  🔍"
                android:textColor="#888888"
                android:textSize="16sp" />

            <TextView
                style="@style/TextPrimary.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Preload variant: the inline (key: searchtop) is pre-rendered HERE at 0x0 while you look at this screen. Tapping the search bar swaps to the search view and only RESIZES the component — no render, no lag.\n\nBack button returns here (component shrinks back to 0x0, stays loaded)." />

            <Button
                android:id="@+id/btn_open_laggy"
                style="@style/ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Compare: open as new Activity (laggy variant)" />

            <Button
                android:id="@+id/btn_reveal_gone"
                style="@style/ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Variant 3: preload hidden (GONE) → tap to reveal" />

            <FrameLayout
                android:id="@+id/gone_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- STATE 2: SEARCH — swapped in on search bar tap -->
        <LinearLayout
            android:id="@+id/search_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:visibility="gone">

            <EditText
                android:id="@+id/search_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_margin="@dimen/space_content"
                android:background="#11000000"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:hint="Search in Sinsay…"
                android:inputType="text" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_content"
                    android:paddingEnd="@dimen/space_content">

                    <TextView
                        style="@style/TextPrimary.Medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Popular now"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/chip_1"
                            style="@style/ButtonPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔥 dress" />

                        <Button
                            android:id="@+id/chip_2"
                            style="@style/ButtonPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="🔥 shorts" />

                        <Button
                            android:id="@+id/chip_3"
                            style="@style/ButtonPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="🔥 flip-flops" />

                    </LinearLayout>

                    <TextView
                        style="@style/TextPrimary.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Timing Log:" />

                    <TextView
                        android:id="@+id/log_text"
                        style="@style/TextSecondary.Mini"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace" />

                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- Inline overlay — lives here permanently; 0 height until search opens,
             then MATCH_PARENT = full screen above everything -->
        <FrameLayout
            android:id="@+id/inline_container"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

    </FrameLayout>
</LinearLayout>
