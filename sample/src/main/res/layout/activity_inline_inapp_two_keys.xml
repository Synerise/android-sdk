<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/include_app_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_content">

            <TextView
                style="@style/TextPrimary.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Placement: inlinedemand (ON_DEMAND)"
                android:layout_marginBottom="4dp" />

            <FrameLayout
                android:id="@+id/container_on_demand"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="#11000000" />

            <Button
                android:id="@+id/btn_render"
                style="@style/ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="render() (ON_DEMAND)" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="#22000000" />

            <TextView
                style="@style/TextPrimary.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Placement: inlineevent (EVENT)"
                android:layout_marginBottom="4dp" />

            <FrameLayout
                android:id="@+id/container_event"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="#11000000" />

            <Button
                android:id="@+id/btn_send_event"
                style="@style/ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Send event (inline.two_keys)" />

        </LinearLayout>
    </ScrollView>

    <TextView
        style="@style/TextPrimary.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_content"
        android:paddingEnd="@dimen/space_content"
        android:text="Callback Log:" />

    <ScrollView
        android:id="@+id/log_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/space_content">

        <TextView
            android:id="@+id/log_text"
            style="@style/TextSecondary.Mini"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace" />

    </ScrollView>
</LinearLayout>
